# Copy to .env and fill in for local development.

# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/marketmap?schema=public"

# Market data adapter (default: yahoo = public Yahoo chart + quote HTTP, no API key)
# MARKET_DATA_PROVIDER=yahoo

# Annual risk-free rate as a decimal, e.g. 4% => 0.04. Used in Sharpe ratio in domain services.
# RISK_FREE_ANNUAL=0.04

# Engine 1 (analyst revision detector) — Financial Modeling Prep
FMP_API_KEY=""
# FMP_BASE_URL=https://financialmodelingprep.com
# FMP_TIER=ultimate            # ultimate enables bulk-CSV ingestion; else premium
# FMP_CALLS_PER_MINUTE=2800    # politeness budget (Premium ~750, Ultimate ~3000)

# COMMODITIES tab — AEGIS OData forward-curve feed.
# Token: log into platform.aegis-hedging.com, click username (bottom-left),
# copy the "OData Auth" JWT. Tokens EXPIRE (~quarterly) — the daily ingest
# reports authFailed when it lapses; paste a fresh one here and restart.
AEGIS_ODATA_TOKEN=""
# AEGIS_ODATA_USER=you@example.com   # platform login email (Basic-auth username)
# AEGIS_ODATA_URL=https://platform.aegis-hedging.com/odata
